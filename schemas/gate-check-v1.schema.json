{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/gate-check-v1.schema.json",
  "title": "Vee Gate Check Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "reviewed_snapshot_id", "current_snapshot_id", "effective_config_digest", "status", "decision_id", "blocking_findings", "verification_run_ids", "evidence_digest", "reasons"],
  "properties": {
    "schema_version": {"const": 1},
    "review_id": {"type": "string"},
    "reviewed_snapshot_id": {"type": "string"},
    "current_snapshot_id": {"type": "string"},
    "effective_config_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "status": {"enum": ["pass", "block", "incomplete"]},
    "decision_id": {"type": "string"},
    "blocking_findings": {"type": "array", "items": {"type": "string"}},
    "verification_run_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_digest": {"type": "string"},
    "reasons": {"type": "array", "items": {"type": "string"}}
  }
}
