{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/approval-eligibility-v1.schema.json",
  "title": "Vee Approval Eligibility v1",
  "description": "Whether a reviewed change may be approved without a human. Stages run cheapest first; the change is eligible only when every stage passed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "snapshot_id",
    "eligible",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "eligible": {
      "type": "boolean"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "passed",
          "detail"
        ],
        "properties": {
          "id": {
            "enum": [
              "snapshot",
              "paths",
              "authors",
              "owners",
              "policy",
              "risk",
              "gate"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
