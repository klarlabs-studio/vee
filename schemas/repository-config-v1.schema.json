{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/repository-config-v1.schema.json",
  "title": "Vee repository configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "offline": {
      "type": "boolean"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_context_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "max_context_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "max_context_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "test_generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 131072,
          "default": 20000
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/provider"
      }
    },
    "reviewers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/reviewer"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/verification"
      }
    },
    "hosting": {
      "$ref": "#/$defs/hosting"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "description": "Guards on when a change whose gate passes may be approved without a human (vee gate approval).",
      "properties": {
        "never_paths": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 512 }, "description": "Changes touching these paths (globs) always need a human." },
        "never_authors": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 512 }, "description": "Changes with a commit by an author whose name or email matches (globs) always need a human." },
        "max_risk": { "enum": ["low", "elevated"], "default": "low", "description": "Highest change-risk tier still eligible." }
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "policy_profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/policy"
      }
    },
    "packs": {
      "type": "array",
      "description": "Digest-pinned policy packs merged into this configuration; see policy-pack-v1.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cli",
            "codex_cli",
            "gemini_cli",
            "antigravity_cli",
            "claude_cli",
            "openai_compatible",
            "ollama_native"
          ]
        },
        "egress": {
          "enum": [
            "local",
            "network"
          ]
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 131072,
          "description": "Approximate provider input token budget; impact context is reduced before execution while changed source is preserved."
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072,
          "description": "ollama_native only; maximum generated tokens, default 2048. The input and output budgets must fit in context_window_tokens."
        },
        "context_window_tokens": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 131072,
          "description": "Required for ollama_native; sent as Ollama's native options.num_ctx."
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "pricing": {
          "type": "object",
          "description": "Optional user-maintained model token prices used for informational cost estimates only.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_usd_per_million",
              "output_usd_per_million"
            ],
            "properties": {
              "input_usd_per_million": {
                "type": "number",
                "minimum": 0
              },
              "output_usd_per_million": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "instructions_file"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "instructions_file": {
          "type": "string"
        },
        "context_files": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policy": {
          "$ref": "#/$defs/reviewer_policy"
        },
        "strategy": {
          "enum": ["whole_change", "focused"],
          "default": "whole_change",
          "description": "whole_change sends the change in one request. focused reviews each changed file with a reasoning request followed by a structuring request whose findings are located by a quoted changed line; it suits small local models and requires an ollama_native provider."
        },
        "advisory": {
          "type": "boolean",
          "default": false,
          "description": "Findings from this reviewer are shown but never block the gate. A finding another, non-advisory reviewer also reports can still block."
        },
        "effort": {
          "enum": ["low", "medium", "high"],
          "description": "Preset for samples: low runs the reviewer once, medium three times, high five times. Cannot be combined with samples. `vee review --effort` overrides it for one review."
        },
        "samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1,
          "description": "How many times the review request is sent. Findings from the runs are merged by location and record how many runs reported them. Costs that many provider calls."
        },
        "sample_quorum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "How many runs must report a finding for it to block the gate; must not exceed samples. Defaults to a strict majority. Findings below the quorum are kept as advisory."
        }
      }
    },
    "reviewer_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_severities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          }
        },
        "minimum_confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "egress": {
          "enum": [
            "local",
            "network"
          ],
          "default": "network",
          "description": "Declared check network behavior; local is an operator assertion, not OS-level network isolation."
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "output_limit_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sarif": {
          "type": "object",
          "additionalProperties": false,
          "description": "Treat this profile as a trusted static analyzer whose stdout is SARIF 2.1.0.",
          "properties": {
            "block_levels": {
              "type": "array",
              "items": {
                "enum": [
                  "error",
                  "warning",
                  "note",
                  "none"
                ]
              },
              "uniqueItems": true,
              "description": "SARIF levels that block the gate when reported on a changed line; empty means advisory."
            }
          }
        }
      }
    },
    "hosting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "github",
            "gitlab",
            "bitbucket",
            "azure-devops",
            "gerrit"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "api_base": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "token_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "webhook_secret_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "actor_login": {
          "type": "string",
          "maxLength": 256
        },
        "username": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_verifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "block_severities": {
          "type": "array",
          "items": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          }
        },
        "minimum_confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "on_unreviewed": {
          "enum": ["block", "allow"],
          "default": "block",
          "description": "block: a changed file inside review.include/exclude that no reviewer received leaves the analysis incomplete. allow: such files are only reported in unreviewed_paths."
        },
        "on_incomplete": {
          "enum": [
            "block",
            "allow"
          ]
        },
        "acceptance": {
          "$ref": "#/$defs/acceptance_policy"
        }
      }
    },
    "acceptance_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_passing_verification": {
          "type": "boolean"
        },
        "required_verification_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
