{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.dev/schemas/local-review-analytics-v3.schema.json",
  "title": "Vee Local Review Analytics v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_count", "history_complete", "dimensions_complete", "reviews_by_day", "review_dimensions", "findings_by_severity", "finding_drilldown", "finding_drilldown_total", "finding_drilldown_complete", "explicit_feedback_by_label", "feedback_note"],
  "properties": {
    "schema_version": { "const": 3 },
    "review_count": { "type": "integer", "minimum": 0 },
    "history_complete": { "type": "boolean" },
    "dimensions_complete": { "type": "boolean" },
    "reviews_by_day": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["day", "pass", "block", "incomplete", "ungated"],
        "properties": {
          "day": { "type": "string" },
          "pass": { "type": "integer", "minimum": 0 },
          "block": { "type": "integer", "minimum": 0 },
          "incomplete": { "type": "integer", "minimum": 0 },
          "ungated": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "review_dimensions": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["review_id", "day", "status", "reviewer_ids", "provider_ids", "finding_categories"],
        "properties": {
          "review_id": { "type": "string" }, "day": { "type": "string" },
          "status": { "enum": ["pass", "block", "incomplete", "ungated"] },
          "reviewer_ids": { "type": "array", "items": { "type": "string" } },
          "provider_ids": { "type": "array", "items": { "type": "string" } },
          "finding_categories": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "findings_by_severity": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "finding_drilldown": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "category", "severity", "rationale", "status", "last_seen"],
        "properties": {
          "finding_id": { "type": "string" }, "category": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "rationale": { "type": "string" }, "path": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "status": { "enum": ["open", "verified", "refuted", "resolved", "waived"] },
          "last_review_id": { "type": ["string", "null"] }, "last_seen": { "type": "string" }
        }
      }
    },
    "finding_drilldown_total": { "type": "integer", "minimum": 0 },
    "finding_drilldown_complete": { "type": "boolean" },
    "explicit_feedback_by_label": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "feedback_note": { "type": "string" }
  }
}
