{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vero.dev/schemas/gate-history-v1.schema.json",
  "title": "Vero gate history v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://vero.dev/schemas/gate-decision-v1.schema.json",
        "title": "Vero gate decision v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "decision_id",
          "snapshot_id",
          "effective_config_digest",
          "policy_digest",
          "status",
          "blocking_findings",
          "verification_run_ids",
          "evidence_digest",
          "reasons"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "decision_id": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "effective_config_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "policy_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "pass",
              "block",
              "incomplete"
            ]
          },
          "blocking_findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_run_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
