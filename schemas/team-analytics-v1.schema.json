{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/team-analytics-v1.schema.json",
  "title": "Vee Team Analytics v1",
  "description": "One report over analytics documents collected across repositories and CI runs (vee analytics aggregate). Counts are summed and every rate is recomputed from summed numerators and denominators. No person is named.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "skipped", "reviews", "reviews_without_gate_decision", "gate_decisions", "findings_by_severity", "finding_accuracy", "actionability", "verification_runs", "cost", "approvals", "rules", "limitations"],
  "$defs": {
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_occurrences", "negative_occurrences", "disputed_occurrences", "denominator", "observed_rate"],
      "properties": {
        "positive_occurrences": { "type": "integer", "minimum": 0 },
        "negative_occurrences": { "type": "integer", "minimum": 0 },
        "disputed_occurrences": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "observed_rate": { "$ref": "#/$defs/rate" }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy_denominator", "false_positive_count", "false_positive_rate", "actionability_denominator", "not_actionable_count", "not_actionable_rate", "disputed_occurrences"],
      "properties": {
        "accuracy_denominator": { "type": "integer", "minimum": 0 },
        "false_positive_count": { "type": "integer", "minimum": 0 },
        "false_positive_rate": { "$ref": "#/$defs/rate" },
        "actionability_denominator": { "type": "integer", "minimum": 0 },
        "not_actionable_count": { "type": "integer", "minimum": 0 },
        "not_actionable_rate": { "$ref": "#/$defs/rate" },
        "disputed_occurrences": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "path", "kind"],
        "properties": {
          "label": { "type": "string" },
          "path": { "type": "string" },
          "kind": { "enum": ["quality_analytics", "approval_report", "rule_effectiveness"] },
          "reviews": { "type": "integer", "minimum": 0 },
          "gate_decisions": { "$ref": "#/$defs/counts" },
          "eligible": { "type": "integer", "minimum": 0 },
          "agreement_rate": { "$ref": "#/$defs/rate" },
          "estimated_cost_usd": { "type": "number", "minimum": 0 }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": { "path": { "type": "string" }, "reason": { "type": "string" } }
      }
    },
    "reviews": { "type": "integer", "minimum": 0 },
    "reviews_without_gate_decision": { "type": "integer", "minimum": 0 },
    "gate_decisions": { "$ref": "#/$defs/counts" },
    "findings_by_severity": { "$ref": "#/$defs/counts" },
    "finding_accuracy": { "$ref": "#/$defs/feedback" },
    "actionability": { "$ref": "#/$defs/feedback" },
    "verification_runs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/counts" } },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reported_runs", "unreported_runs", "input_tokens", "output_tokens", "estimated_cost_usd", "priced_runs", "unpriced_runs"],
      "properties": {
        "reported_runs": { "type": "integer", "minimum": 0 },
        "unreported_runs": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "priced_runs": { "type": "integer", "minimum": 0 },
        "unpriced_runs": { "type": "integer", "minimum": 0 }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "pull_requests_read", "with_verdicts", "eligible", "outcomes", "agreement_rate", "override_rate"],
      "properties": {
        "repositories": { "type": "integer", "minimum": 0 },
        "pull_requests_read": { "type": "integer", "minimum": 0 },
        "with_verdicts": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0, "description": "The denominator of both rates." },
        "outcomes": { "$ref": "#/$defs/counts" },
        "agreement_rate": { "$ref": "#/$defs/rate" },
        "override_rate": { "$ref": "#/$defs/rate" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_approvals", "baseline", "after_activation"],
      "properties": {
        "rule_approvals": { "type": "integer", "minimum": 0 },
        "baseline": { "$ref": "#/$defs/window" },
        "after_activation": { "$ref": "#/$defs/window" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
