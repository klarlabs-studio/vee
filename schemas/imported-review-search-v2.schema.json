{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vero.dev/schemas/imported-review-search-v2.schema.json",
  "title": "Vero Imported Review Search v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query", "matches", "trust", "gate_eligible"],
  "properties": {
    "schema_version": { "const": 2 },
    "query": { "type": "string", "minLength": 1 },
    "trust": { "const": "untrusted_external" },
    "gate_eligible": { "const": false },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["archive_digest", "review_id", "snapshot_id", "finding", "relevance_score", "matched_fields", "trust", "gate_eligible"],
        "properties": {
          "archive_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "review_id": { "type": "string", "minLength": 1 },
          "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "finding": { "type": "object" },
          "relevance_score": { "type": "integer", "minimum": 1 },
          "matched_fields": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["category", "path", "provenance", "rationale", "severity"] }
          },
          "trust": { "const": "untrusted_external" },
          "gate_eligible": { "const": false }
        }
      }
    }
  }
}
