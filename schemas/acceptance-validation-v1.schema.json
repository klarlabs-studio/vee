{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/acceptance-validation-v1.schema.json",
  "title": "Vee Acceptance Validation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "snapshot_id", "work_item_digest", "policy_digest", "gate_status", "author", "recorded_at", "result", "assessment_complete", "criteria", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "review_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "work_item_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "policy_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "gate_status": { "enum": ["pass", "block", "incomplete"] },
    "author": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "minLength": 1 },
    "result": { "enum": ["all_attested_met", "attention_required", "evidence_incomplete", "incomplete"] },
    "assessment_complete": { "type": "boolean" },
    "criteria": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "text", "assessment", "rationale", "changed_paths", "verification_runs", "evidence_satisfied", "evidence_reasons"], "properties": {
      "id": { "type": "string", "pattern": "^AC-[a-f0-9]{12}$" },
      "source_id": { "type": "string", "minLength": 1 },
      "text": { "type": "string", "minLength": 1 },
      "evidence_satisfied": { "type": "boolean" },
      "evidence_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "assessment": { "oneOf": [{ "type": "null" }, { "enum": ["met", "not_met", "uncertain"] }] },
      "rationale": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }] },
      "changed_paths": { "type": "array", "items": { "type": "string" } },
      "verification_runs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["run_id", "profile_id", "status", "targets"], "properties": {
        "run_id": { "type": "string" }, "profile_id": { "type": "string" }, "status": { "enum": ["passed", "failed", "timed_out"] }, "targets": { "type": "array", "items": { "type": "string" }
      } } }
    } } } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
