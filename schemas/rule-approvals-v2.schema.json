{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vero.dev/schemas/rule-approvals-v2.schema.json",
  "title": "Vero rule guidance approvals v2",
  "oneOf": [
    { "$ref": "#/$defs/approval" },
    { "type": "array", "items": { "$ref": "#/$defs/approval" } }
  ],
  "$defs": {
    "approval": {
      "type": "object",
      "required": ["schema_version", "approval_id", "version", "candidate_id", "evidence_digest", "source_feedback_ids", "activated_at_unix", "category", "feedback_label", "scope", "instruction", "approver", "approval_reason", "supersedes_approval_id", "expires_at_unix", "created_at", "status", "events"],
      "properties": {
        "schema_version": { "const": 2 },
        "approval_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "candidate_id": { "type": "string", "minLength": 1 },
        "evidence_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
        "source_feedback_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "activated_at_unix": { "type": ["integer", "null"] },
        "category": { "type": "string", "minLength": 1 },
        "feedback_label": { "enum": ["confirmed", "false_positive", "actionable", "not_actionable"] },
        "scope": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "approver": { "type": "string", "minLength": 1 },
        "approval_reason": { "type": "string", "minLength": 1 },
        "supersedes_approval_id": { "type": ["string", "null"] },
        "expires_at_unix": { "type": ["integer", "null"] },
        "created_at": { "type": "string" },
        "status": { "enum": ["active", "revoked", "superseded", "expired"] },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_id", "event", "actor", "reason", "created_at"],
            "properties": {
              "event_id": { "type": "string" },
              "event": { "enum": ["activated", "revoked", "superseded"] },
              "actor": { "type": "string" },
              "reason": { "type": "string" },
              "created_at": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
