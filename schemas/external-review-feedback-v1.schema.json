{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/external-review-feedback-v1.schema.json",
  "title": "Vee External Review Feedback v1",
  "description": "An explicit human label attached to an immutable archived provider comment. This is advisory history and is never gate evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feedback_id", "archive_digest", "provider", "pull_request", "revision", "external_id", "category", "label", "reason", "reviewer", "recorded_at_unix"],
  "properties": {
    "schema_version": { "const": 1 },
    "feedback_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "archive_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "provider": { "type": "string", "minLength": 1 },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "number"],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "full_name"],
          "properties": { "host": { "type": "string", "minLength": 1 }, "full_name": { "type": "string", "minLength": 1 } }
        },
        "number": { "type": "integer", "minimum": 1 }
      }
    },
    "revision": { "type": "string", "minLength": 1 },
    "external_id": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1, "maxLength": 120 },
    "label": { "enum": ["confirmed", "false_positive", "actionable", "not_actionable"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "recorded_at_unix": { "type": "integer", "minimum": 0 }
  }
}
