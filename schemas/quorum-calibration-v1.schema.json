{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/quorum-calibration-v1.schema.json",
  "title": "Vee Quorum Calibration v1",
  "description": "For each enabled reviewer that samples more than once, how many labelled findings each agreement quorum would let block, and the recommended quorum (vee analytics quorum). Labels are each finding's latest `vee findings feedback`; confirmed and actionable count as confirmed, false_positive and not_actionable as rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "min_labeled", "reviewers"],
  "properties": {
    "schema_version": { "const": 1 },
    "min_labeled": { "type": "integer", "minimum": 1, "description": "Fewer labelled findings than this give no recommendation." },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "samples", "configured_quorum", "labeled", "outcomes", "recommended_quorum", "reason"],
        "properties": {
          "reviewer_id": { "type": "string" },
          "samples": { "type": "integer", "minimum": 2 },
          "configured_quorum": { "type": "integer", "minimum": 1 },
          "labeled": { "type": "integer", "minimum": 0, "description": "Labelled findings from runs with the current sample count." },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["quorum", "kept_confirmed", "kept_rejected", "dropped_confirmed", "dropped_rejected"],
              "properties": {
                "quorum": { "type": "integer", "minimum": 1 },
                "kept_confirmed": { "type": "integer", "minimum": 0 },
                "kept_rejected": { "type": "integer", "minimum": 0 },
                "dropped_confirmed": { "type": "integer", "minimum": 0 },
                "dropped_rejected": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "recommended_quorum": { "type": ["integer", "null"], "minimum": 1, "description": "The quorum keeping the most confirmed findings net of rejected ones; ties keep the configured quorum, then go to the higher one. Null with too few labels." },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
