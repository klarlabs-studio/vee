{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vero.dev/schemas/test-effectiveness-corpus-v3.schema.json",
  "title": "Vero test effectiveness corpus report v3",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "snapshot_id",
    "profile_id",
    "baseline_verification_run_id",
    "verification_command_digest",
    "corpus_id",
    "corpus_digest",
    "sample_size",
    "killed",
    "survived",
    "inconclusive",
    "results",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_verification_run_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sample_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "killed": {
      "type": "integer",
      "minimum": 0
    },
    "survived": {
      "type": "integer",
      "minimum": 0
    },
    "inconclusive": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "patch_digest",
          "outcome",
          "baseline_status",
          "mutated_status",
          "mutant_failure_signal",
          "mutant_snapshot_id",
          "mutant_paths",
          "mutated_stdout_digest",
          "mutated_stderr_digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "patch_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "outcome": {
            "enum": [
              "killed",
              "survived",
              "inconclusive"
            ]
          },
          "baseline_status": {
            "enum": [
              "passed",
              "failed",
              "timed_out"
            ]
          },
          "mutated_status": {
            "enum": [
              "passed",
              "failed",
              "timed_out",
              "not_run"
            ]
          },
          "mutant_failure_signal": {
            "type": [
              "string",
              "null"
            ]
          },
          "mutant_snapshot_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "mutant_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mutated_stdout_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "mutated_stderr_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_command_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
