{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.dev/schemas/test-effectiveness-corpus-v1.schema.json",
  "title": "Vee test effectiveness corpus report v1",
  "type": "object",
  "required": [
    "schema_version", "proposal_id", "snapshot_id", "profile_id",
    "baseline_verification_run_id", "corpus_id", "corpus_digest",
    "sample_size", "killed", "survived", "inconclusive", "results", "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "proposal_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "profile_id": { "type": "string", "minLength": 1 },
    "baseline_verification_run_id": { "type": "string", "minLength": 1 },
    "corpus_id": { "type": "string", "minLength": 1 },
    "corpus_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sample_size": { "type": "integer", "minimum": 1, "maximum": 50 },
    "killed": { "type": "integer", "minimum": 0 },
    "survived": { "type": "integer", "minimum": 0 },
    "inconclusive": { "type": "integer", "minimum": 0 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "patch_digest", "outcome", "baseline_status", "mutated_status", "mutant_failure_signal"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "patch_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "outcome": { "enum": ["killed", "survived", "inconclusive"] },
          "baseline_status": { "enum": ["passed", "failed", "timed_out"] },
          "mutated_status": { "enum": ["passed", "failed", "timed_out", "not_run"] },
          "mutant_failure_signal": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
