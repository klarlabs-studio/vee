{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vero.dev/schemas/historical-review-corpus-v1.schema.json",
  "title": "Vero local historical review corpus v1",
  "type": "object",
  "required": ["schema_version", "corpus_id", "source", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
    "source": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "source_revision": { "type": "string", "maxLength": 256 },
    "license_reference": { "type": "string", "maxLength": 2048 },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "required": ["id", "repository", "commit", "labels", "labels_digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
          "repository": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
          "labels": { "type": "string", "minLength": 1 },
          "labels_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "defect_reference": { "type": "string", "maxLength": 2048 },
          "fix_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
          "fix_reference": { "type": "string", "maxLength": 2048 },
          "project_license": { "type": "string", "maxLength": 2048 },
          "category_aliases": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
