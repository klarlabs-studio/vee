{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.dev/schemas/finding-feedback-v1.schema.json",
  "title": "Vee Finding Feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feedback_id", "finding_id", "snapshot_id", "label", "reason", "reviewer", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "feedback_id": { "type": "string", "minLength": 1 },
    "finding_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "label": { "enum": ["confirmed", "false_positive", "actionable", "not_actionable"] },
    "reason": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
