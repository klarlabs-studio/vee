{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vero.dev/schemas/cross-repository-impact-v11.schema.json",
  "title": "Vero cross-repository impact with API pattern-change signals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_snapshot_id",
    "changed_symbols",
    "api_contract_changes",
    "api_contract_compatibility",
    "dependency_paths",
    "references",
    "coverage_complete",
    "limitations",
    "digest",
    "api_contract_coverage"
  ],
  "properties": {
    "schema_version": {
      "const": 11
    },
    "producer_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "changed_symbols": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "api_contract_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer_path",
          "producer_digest",
          "method",
          "route",
          "operation_id"
        ],
        "properties": {
          "producer_path": {
            "type": "string",
            "minLength": 1
          },
          "producer_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "method": {
            "enum": [
              "DELETE",
              "GET",
              "HEAD",
              "OPTIONS",
              "PATCH",
              "POST",
              "PUBLISH",
              "RECEIVE",
              "PUT",
              "SUBSCRIBE",
              "TRACE"
            ]
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "operation_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "api_contract_compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer_path",
          "issue",
          "method",
          "route",
          "previous_operation_id",
          "current_operation_id",
          "component_path"
        ],
        "properties": {
          "producer_path": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "enum": [
              "channel_address_changed",
              "operation_id_changed",
              "operation_id_removed",
              "operation_removed",
              "parameter_enum_narrowed",
              "parameter_format_changed",
              "parameter_nullable_removed",
              "parameter_pattern_changed",
              "parameter_range_narrowed",
              "parameter_size_range_narrowed",
              "parameter_type_changed",
              "request_body_required",
              "request_composition_branch_removed",
              "request_enum_narrowed",
              "request_media_type_removed",
              "request_nullable_removed",
              "request_numeric_range_narrowed",
              "request_property_removed",
              "request_property_type_changed",
              "request_required_property_added",
              "request_schema_pattern_changed",
              "request_schema_size_range_narrowed",
              "request_schema_type_changed",
              "required_parameter_added",
              "response_composition_branch_added",
              "response_enum_broadened",
              "response_media_type_removed",
              "response_nullable_added",
              "response_numeric_range_broadened",
              "response_property_removed",
              "response_property_type_changed",
              "response_required_property_removed",
              "response_schema_pattern_changed",
              "response_schema_size_range_broadened",
              "response_schema_type_changed",
              "response_status_removed",
              "schema_composition_changed",
              "security_requirements_changed",
              "security_scheme_definition_changed",
              "security_scheme_definition_removed"
            ]
          },
          "method": {
            "enum": [
              "DELETE",
              "GET",
              "HEAD",
              "OPTIONS",
              "PATCH",
              "POST",
              "PUBLISH",
              "RECEIVE",
              "PUT",
              "SUBSCRIBE",
              "TRACE"
            ]
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "previous_operation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "current_operation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "component_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "dependency_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer_package",
          "consumer_package",
          "packages",
          "manifest_digests"
        ],
        "properties": {
          "producer_package": {
            "type": "string",
            "minLength": 1
          },
          "consumer_package": {
            "type": "string",
            "minLength": 1
          },
          "packages": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "manifest_digests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "consumer_repository",
          "path",
          "line",
          "symbol",
          "certainty",
          "match_context",
          "source_digest",
          "consumer_package_id",
          "dependency_status",
          "dependency_paths"
        ],
        "properties": {
          "consumer_repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "certainty": {
            "enum": [
              "inferred_syntax",
              "heuristic_lexical",
              "semantic_resolved"
            ]
          },
          "match_context": {
            "enum": [
              "function_call",
              "method_call",
              "call",
              "qualified_reference",
              "identifier_reference"
            ]
          },
          "source_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "consumer_package_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependency_status": {
            "enum": [
              "declared_downstream",
              "no_declared_path",
              "package_unresolved"
            ]
          },
          "dependency_paths": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "producer_package",
                "consumer_package",
                "packages",
                "manifest_digests"
              ],
              "properties": {
                "producer_package": {
                  "type": "string",
                  "minLength": 1
                },
                "consumer_package": {
                  "type": "string",
                  "minLength": 1
                },
                "packages": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "manifest_digests": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "api_contract_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer_path",
          "method",
          "route",
          "analyzed",
          "not_analyzed",
          "status"
        ],
        "properties": {
          "producer_path": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "DELETE",
              "GET",
              "HEAD",
              "OPTIONS",
              "PATCH",
              "POST",
              "PUBLISH",
              "RECEIVE",
              "PUT",
              "SUBSCRIBE",
              "TRACE"
            ]
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "analyzed": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "all_of_object_constraints",
                "asyncapi_channel",
                "asyncapi_inline_message_schema",
                "asyncapi_operation_id",
                "asyncapi_single_local_message_references",
                "inline_request_schema",
                "inline_response_schema",
                "local_schema_references",
                "operation_id",
                "parameter_enum",
                "parameter_format",
                "parameter_numeric_range",
                "parameter_pattern",
                "parameter_size_range",
                "parameter_type",
                "request_media_type",
                "requiredness",
                "response_media_type",
                "response_status",
                "route",
                "schema_composition_shape",
                "schema_const_constraints",
                "schema_enum_constraints",
                "schema_nullable_constraints",
                "schema_numeric_range_constraints",
                "schema_pattern_constraints",
                "schema_size_range_constraints",
                "schema_type_constraints",
                "security_requirements",
                "security_scheme_definitions"
              ]
            }
          },
          "not_analyzed": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "asyncapi_bindings",
                "asyncapi_message_references_and_variants",
                "asyncapi_message_variants_and_external_references",
                "parameter_schema_constraints",
                "request_schema_constraints",
                "response_schema_constraints",
                "schema_composition_semantics",
                "schema_pattern_language_inclusion",
                "security_scheme_runtime_semantics",
                "unresolved_schema_reference"
              ]
            }
          },
          "status": {
            "const": "incomplete"
          }
        }
      }
    }
  }
}
