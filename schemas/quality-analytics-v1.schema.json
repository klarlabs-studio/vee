{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/quality-analytics-v1.schema.json",
  "title": "Vee Local Quality Analytics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_count",
    "latest_gate_decisions",
    "reviews_without_gate_decision",
    "findings_by_status",
    "findings_by_severity"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "review_count": { "type": "integer", "minimum": 0 },
    "latest_gate_decisions": { "$ref": "#/$defs/counts" },
    "reviews_without_gate_decision": { "type": "integer", "minimum": 0 },
    "findings_by_status": { "$ref": "#/$defs/counts" },
    "findings_by_severity": { "$ref": "#/$defs/counts" }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
