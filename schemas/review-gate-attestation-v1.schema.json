{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/review-gate-attestation-v1.schema.json",
  "title": "Vee review gate attestation v1",
  "description": "An in-toto Statement v1 whose predicate (https://vee.klarlabs.de/attestations/review-gate/v1) records a Vee gate decision. `vee reviews attest --format statement` prints it; `--format dsse` signs it into a DSSE envelope with payloadType application/vnd.in-toto+json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "gitCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://vee.klarlabs.de/attestations/review-gate/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier",
        "timeVerified",
        "review",
        "decision",
        "policy",
        "reviewers",
        "verifications",
        "analyzers",
        "evidence_bundle"
      ],
      "properties": {
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "timeVerified": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review_id",
            "snapshot_id",
            "scope",
            "base_oid",
            "head_oid",
            "changed_files"
          ],
          "properties": {
            "review_id": {
              "type": "string"
            },
            "snapshot_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "scope": {
              "type": "string"
            },
            "base_oid": {
              "type": [
                "string",
                "null"
              ]
            },
            "head_oid": {
              "type": [
                "string",
                "null"
              ]
            },
            "changed_files": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision_id",
            "status",
            "blocking_findings",
            "reasons",
            "evidence_digest"
          ],
          "properties": {
            "decision_id": {
              "type": "string"
            },
            "status": {
              "enum": [
                "pass",
                "block",
                "incomplete"
              ]
            },
            "blocking_findings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_digest": {
              "type": "string"
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_digest",
            "effective_config_digest"
          ],
          "properties": {
            "policy_digest": {
              "type": "string"
            },
            "effective_config_digest": {
              "type": "string"
            }
          }
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer_id",
              "provider_kind",
              "model",
              "provider_version",
              "status"
            ],
            "properties": {
              "reviewer_id": {
                "type": "string"
              },
              "provider_kind": {
                "type": "string"
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provider_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "verifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "profile_id",
              "status",
              "command_digest",
              "stdout_digest"
            ],
            "properties": {
              "run_id": {
                "type": "string"
              },
              "profile_id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "command_digest": {
                "type": "string"
              },
              "stdout_digest": {
                "type": "string"
              }
            }
          }
        },
        "analyzers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile_id",
              "run_id",
              "tools",
              "results_on_changed_lines",
              "blocking_findings"
            ],
            "properties": {
              "profile_id": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "results_on_changed_lines": {
                "type": "integer",
                "minimum": 0
              },
              "blocking_findings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "evidence_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_digest"
          ],
          "properties": {
            "manifest_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
