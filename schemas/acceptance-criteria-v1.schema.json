{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vero.dev/schemas/acceptance-criteria-v1.schema.json",
  "title": "Vero structured acceptance criteria v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 16384}
        }
      }
    }
  }
}
