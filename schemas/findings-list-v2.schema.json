{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.dev/schemas/findings-list-v2.schema.json",
  "title": "Vee findings list v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "findings",
    "limit",
    "offset",
    "total"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Page size applied."
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of matching findings skipped."
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of findings matching the filters before paging."
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "finding",
        "status",
        "status_reason",
        "occurrence_count",
        "first_seen",
        "last_seen",
        "occurrences"
      ],
      "properties": {
        "finding": {
          "$ref": "#/$defs/finding"
        },
        "status": {
          "enum": [
            "open",
            "verified",
            "refuted",
            "resolved",
            "waived"
          ]
        },
        "status_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "occurrence_count": {
          "type": "integer",
          "minimum": 0
        },
        "first_seen": {
          "type": "string"
        },
        "last_seen": {
          "type": "string"
        },
        "occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "review_id",
              "snapshot_id",
              "observed_at"
            ],
            "properties": {
              "review_id": {
                "type": "string"
              },
              "snapshot_id": {
                "type": "string"
              },
              "observed_at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "fingerprint",
        "category",
        "severity",
        "confidence",
        "rationale",
        "path",
        "line",
        "provenance",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "confidence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "rationale": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "provenance": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "A bounded page of persisted findings. Returned identically by `vee findings list --output json` and the MCP `list_findings` tool."
}
