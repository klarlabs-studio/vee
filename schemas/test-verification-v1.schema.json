{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vero.dev/schemas/test-verification-v1.schema.json",
  "title": "Vero generated test proposal verification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "verification_run"],
  "properties": {
    "schema_version": { "const": 1 },
    "proposal_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "verification_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "snapshot_id", "profile_id", "command_digest", "status", "exit_code", "stdout_digest", "stderr_digest", "stdout_artifact", "stderr_artifact", "finding_id"],
      "properties": {
        "schema_version": { "const": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "profile_id": { "type": "string", "minLength": 1 },
        "command_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "status": { "enum": ["passed", "failed", "timed_out"] },
        "exit_code": { "type": ["integer", "null"] },
        "stdout_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "stderr_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "stdout_artifact": { "$ref": "#/$defs/artifact_reference" },
        "stderr_artifact": { "$ref": "#/$defs/artifact_reference" },
        "finding_id": { "type": ["string", "null"] },
        "targets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  },
  "$defs": {
    "artifact_reference": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "path", "size_bytes"],
          "properties": {
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "path": { "type": "string", "pattern": "^\\.vero/artifacts/sha256/[0-9a-f]{64}$" },
            "size_bytes": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  }
}
