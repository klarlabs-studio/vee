{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/provider-findings-v1.schema.json",
  "title": "Vee provider findings v1",
  "type": "object",
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "severity", "rationale"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "confidence": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
          "rationale": {"type": "string", "minLength": 1},
          "path": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "rule_attributions": {
            "type": "array",
            "description": "Optional reviewer-reported links to approved guidance shown in this review request.",
            "items": {
              "type": "object",
              "required": ["rule_id", "approval_id"],
              "properties": {
                "rule_id": {"type": "string", "minLength": 1},
                "approval_id": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
