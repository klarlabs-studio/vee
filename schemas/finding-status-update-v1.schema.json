{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vero.dev/schemas/finding-status-update-v1.schema.json",
  "title": "Vero Finding Status Update v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "status", "reason", "note"],
  "properties": {
    "schema_version": { "const": 1 },
    "finding_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "verified", "refuted", "resolved"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "note": { "type": "string", "minLength": 1 }
  }
}
