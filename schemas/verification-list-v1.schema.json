{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/verification-list-v1.schema.json",
  "title": "Vee verification runs for an exact snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "snapshot_id",
          "profile_id",
          "status",
          "targets",
          "has_stdout_artifact",
          "has_stderr_artifact"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "timed_out",
              "incomplete"
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "has_stdout_artifact": {
            "type": "boolean"
          },
          "has_stderr_artifact": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
