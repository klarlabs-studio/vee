{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vero.dev/schemas/test-effectiveness-v4.schema.json",
  "title": "Vero seeded mutant effectiveness assessment v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "snapshot_id",
    "profile_id",
    "baseline_verification_run_id",
    "verification_command_digest",
    "mutant_patch_digest",
    "mutant_snapshot_id",
    "mutant_paths",
    "baseline_status",
    "mutated_status",
    "outcome",
    "mutant_failure_signal",
    "baseline_stdout_digest",
    "baseline_stderr_digest",
    "mutated_stdout_digest",
    "mutated_stderr_digest",
    "limitations",
    "coverage_run",
    "changed_line_coverage"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_verification_run_id": {
      "type": "string",
      "minLength": 1
    },
    "mutant_patch_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mutant_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mutant_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseline_status": {
      "enum": [
        "passed",
        "failed",
        "timed_out",
        "incomplete"
      ]
    },
    "mutated_status": {
      "enum": [
        "passed",
        "failed",
        "timed_out",
        "not_run"
      ]
    },
    "outcome": {
      "enum": [
        "killed",
        "survived",
        "inconclusive"
      ]
    },
    "mutant_failure_signal": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseline_stdout_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baseline_stderr_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mutated_stdout_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$|^$"
    },
    "mutated_stderr_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$|^$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_command_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "coverage_run": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "run_id",
        "snapshot_id",
        "profile_id",
        "stream"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "stream": {
          "enum": [
            "stdout",
            "stderr"
          ]
        }
      },
      "additionalProperties": false
    },
    "changed_line_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "changed_line_count",
          "changed_executable_lines",
          "changed_covered_lines",
          "changed_percent"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "changed_line_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "changed_executable_lines": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "changed_covered_lines": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "changed_percent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    }
  }
}
