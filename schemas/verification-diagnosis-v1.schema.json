{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.dev/schemas/verification-diagnosis-v1.schema.json",
  "title": "Vee Verification Diagnosis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "snapshot_id", "profile_id", "status", "targets", "changed_paths", "diagnostics", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed", "timed_out"] },
    "targets": { "type": "array", "items": { "type": "string" } },
    "changed_paths": { "type": "array", "items": { "type": "string" } },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provenance", "stream", "line", "kind", "text", "referenced_changed_paths"],
        "properties": {
          "provenance": { "const": "untrusted_verification_output" },
          "stream": { "enum": ["stdout", "stderr"] },
          "line": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["test_failure", "compile_error", "runtime_failure"] },
          "text": { "type": "string" },
          "referenced_changed_paths": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
