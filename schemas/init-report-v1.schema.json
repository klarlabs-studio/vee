{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/init-report-v1.schema.json",
  "title": "Vee init report v1",
  "description": "Files written by `vee init --output json`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_config",
    "repository_config_status",
    "reviewer_instructions",
    "reviewer_instructions_created",
    "user_config",
    "provider_status",
    "provider_id",
    "candidate_id",
    "egress",
    "detection"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository_config": {
      "type": "string"
    },
    "repository_config_status": {
      "enum": [
        "written",
        "existing"
      ]
    },
    "reviewer_instructions": {
      "type": "string"
    },
    "reviewer_instructions_created": {
      "type": "boolean"
    },
    "user_config": {
      "type": "string"
    },
    "provider_status": {
      "enum": [
        "written",
        "existing"
      ]
    },
    "provider_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "egress": {
      "enum": [
        "local",
        "network"
      ]
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "This machine's review effort after init, when one is set."
    },
    "detection": {
      "$ref": "provider-detection-v1.schema.json"
    },
    "security_scanners": {
      "type": "array",
      "description": "Security scanners found on this machine (ADR 0029).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "covers",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "covers": {
            "type": "string"
          },
          "status": {
            "enum": [
              "configured",
              "unsupported"
            ],
            "description": "configured: Vee runs it as a gate analyzer; unsupported: found but not usable, see reason."
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "security_config": {
      "type": "string",
      "description": "For an existing repository: the verification and policy_profiles configuration to add to .vee.yaml to use the scanners."
    }
  }
}
