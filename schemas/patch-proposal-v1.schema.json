{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vee.klarlabs.de/schemas/patch-proposal-v1.schema.json",
  "title": "Vee Patch Proposal",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "snapshot_id",
    "effective_config_digest",
    "patch_digest",
    "patch_bytes",
    "validated",
    "application",
    "approval_instruction",
    "patch_path",
    "patch_inputs",
    "patch_input_digest",
    "patch_sandbox_result_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "review_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "effective_config_digest": { "type": "string", "minLength": 1 },
    "patch_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "patch_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
    "validated": { "const": true },
    "application": { "enum": ["not_applied", "applied"] },
    "approval_instruction": { "type": "string", "minLength": 1 },
    "patch_path": { "type": "string", "minLength": 1 },
    "patch_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "mode", "content_digest", "status"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mode": { "type": "integer", "minimum": 0 },
          "content_digest": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "patch_input_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "patch_sandbox_result_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "approval_digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "concurrent_mutation_detected": { "type": "boolean" },
    "applied_at_unix": { "type": "integer", "minimum": 0 },
    "follow_up_review_id": { "type": "string", "minLength": 1 },
    "follow_up_snapshot_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
